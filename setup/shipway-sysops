#!/usr/bin/env bash
#
# shipway-sysops — the narrow, whitelisted root helper. Installed by
# setup/install.sh at /usr/local/bin/shipway-sysops, owned root:root, mode
# 0755. It is invoked as `sudo shipway-sysops <verb> <dest>` by the
# `deployer` user (see sudoers.d-shipway), which is the trust boundary
# Shipway's own process (running as `deployer`) crosses to touch root-owned
# nginx/systemd config.
#
# This is the ONLY sudoers entry that takes an argument shipway itself
# chooses (a file path) — every other sudoers entry below is a fixed,
# argument-free (or glob-anchored) command. So this script is the one place
# that argument validation actually matters: everything between `deployer`
# and writing/removing an arbitrary root-owned file is the whitelist below.
#
# Verbs:
#   install-file <dest>   Reads content from stdin, writes it to <dest>
#                          atomically (mktemp alongside <dest> + mv, so the
#                          rename is on the same filesystem), mode 0644.
#   remove-file <dest>    Removes <dest> (rm -f — a missing file is not an
#                          error).
#   pgadmin-sync          Reads a server list from stdin and hands it to
#                          /opt/pgadmin/sync-servers.py, run as the `pgadmin`
#                          user (whose config database is the only thing it
#                          touches). Takes no path argument at all — the script
#                          and the interpreter are both fixed here — so there is
#                          nothing for the whitelist below to check. A host with
#                          no pgAdmin installed succeeds and does nothing.
#
# <dest> must match one of:
#   /etc/nginx/sites-available/shipway-<slug>.conf
#   /etc/nginx/sites-enabled/shipway-<slug>.conf
#   /etc/systemd/system/shipway-<unit>.service
#   /etc/nginx/shipway-auth/shipway-<slug>.htpasswd
#
# Anything else — an unknown verb, the wrong argument count, or a <dest>
# outside the whitelist — prints an error to stderr and exits 2. Nothing is
# ever written or removed outside those two directories/patterns.

set -euo pipefail

readonly NGINX_DEST_RE='^/etc/nginx/sites-(available|enabled)/shipway-[a-z0-9-]+\.conf$'
readonly SYSTEMD_DEST_RE='^/etc/systemd/system/shipway-[a-z0-9@.-]+\.service$'
# Per-project basic-auth files for `auth_basic_user_file`. Same anchored shape as the vhost
# pattern (no dots, no slashes, no `..` can appear in <slug>), confined to one directory that
# install.sh creates and nothing else writes to.
readonly HTPASSWD_DEST_RE='^/etc/nginx/shipway-auth/shipway-[a-z0-9-]+\.htpasswd$'

# Fixed paths for the pgadmin-sync verb: pgAdmin's own venv interpreter and the
# sync script install.sh puts beside it. Neither is caller-supplied.
readonly PGADMIN_PYTHON=/opt/pgadmin/venv/bin/python
readonly PGADMIN_SYNC=/opt/pgadmin/sync-servers.py

usage() {
  echo "usage: shipway-sysops install-file <dest>   (content read from stdin)" >&2
  echo "       shipway-sysops remove-file <dest>" >&2
  echo "       shipway-sysops pgadmin-sync          (server list read from stdin)" >&2
}

# Exits 2 (with a message on stderr) unless $1 matches the nginx-vhost or
# systemd-unit whitelist above.
assert_whitelisted() {
  local dest="$1"
  if [[ "$dest" =~ $NGINX_DEST_RE ]] || [[ "$dest" =~ $SYSTEMD_DEST_RE ]] || [[ "$dest" =~ $HTPASSWD_DEST_RE ]]; then
    return 0
  fi
  echo "shipway-sysops: refusing to touch path outside the whitelist: $dest" >&2
  exit 2
}

install_file() {
  local dest="$1"
  assert_whitelisted "$dest"

  local dir
  dir="$(dirname -- "$dest")"
  if [[ ! -d "$dir" ]]; then
    echo "shipway-sysops: directory does not exist: $dir" >&2
    exit 2
  fi

  # mktemp in the SAME directory as dest, so the final `mv` below is a rename
  # on one filesystem (atomic), never a cross-filesystem copy.
  local tmp
  tmp="$(mktemp "${dest}.XXXXXX")"
  trap 'rm -f "$tmp"' EXIT

  cat > "$tmp"
  chmod 0644 "$tmp"
  mv -f "$tmp" "$dest"

  trap - EXIT
}

remove_file() {
  local dest="$1"
  assert_whitelisted "$dest"
  rm -f "$dest"
}

# Runs the pgAdmin server sync as the `pgadmin` user, with the payload on stdin
# passed straight through. Not an error on a host where pgAdmin was never
# installed: Shipway syncs on every database create/drop and would otherwise log
# a failure on each one for a console that isn't there.
pgadmin_sync() {
  if [[ ! -x "$PGADMIN_PYTHON" || ! -f "$PGADMIN_SYNC" ]]; then
    echo "shipway-sysops: pgAdmin is not installed here; nothing to sync" >&2
    return 0
  fi
  runuser -u pgadmin -- env HOME=/var/lib/pgadmin "$PGADMIN_PYTHON" "$PGADMIN_SYNC"
}

if [[ $# -lt 1 ]]; then
  usage
  exit 2
fi

verb="$1"

case "$verb" in
  install-file | remove-file)
    if [[ $# -ne 2 ]]; then
      usage
      exit 2
    fi
    if [[ "$verb" == "install-file" ]]; then
      install_file "$2"
    else
      remove_file "$2"
    fi
    ;;
  pgadmin-sync)
    if [[ $# -ne 1 ]]; then
      usage
      exit 2
    fi
    pgadmin_sync
    ;;
  *)
    echo "shipway-sysops: unknown verb: $verb" >&2
    usage
    exit 2
    ;;
esac
